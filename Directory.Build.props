<Project>
  <!-- Per-machine settings (game folder etc.), gitignored. Copy Directory.Build.local.props.example to start. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />

  <PropertyGroup>
    <!-- Folder containing SpaceEngineers.exe. Set it in Directory.Build.local.props, an SEBin environment
         variable, or dotnet build -p:SEBin=...; the default is Steam's standard library. -->
    <SEBin Condition="'$(SEBin)' == ''">$(MSBuildProgramFiles32)\Steam\steamapps\common\SpaceEngineers\Bin64</SEBin>
    <!-- net48 = Pulsar Legacy (.NET Framework), net9.0 = Pulsar Interim (.NET 10 runtime) -->
    <TargetFrameworks>net48;net9.0</TargetFrameworks>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Version>0.1.0</Version>
    <!-- Hot-reloaded assemblies (Host, Core) need a new identity on every build: .NET Framework caches
         dependency binding by name + version, so a reloaded Host would otherwise get the previous Core.
         0.1.<days since 2026-01-01>.<seconds of day / 2> -->
    <SEMcpBuildStamp>$([System.DateTime]::UtcNow.Subtract($([System.DateTime]::Parse('2026-01-01'))).Days).$([System.Convert]::ToInt32($([MSBuild]::Divide($([System.DateTime]::UtcNow.TimeOfDay.TotalSeconds), 2))))</SEMcpBuildStamp>

    <!-- Where the reloadable Host + Core DLLs are deployed; the loader reads them from here. -->
    <SEMcpHostRoot Condition="'$(SEMcpHostRoot)' == ''">$(APPDATA)\SpaceEngineers\SEMcp\host</SEMcpHostRoot>
    <!-- Pulsar's install folder (loads precompiled plugins from <flavour>\Local). -->
    <PulsarDir Condition="'$(PulsarDir)' == ''">$(APPDATA)\Pulsar</PulsarDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the SDK build net48 without the targeting pack installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Game assemblies: never copied, always taken from the game at runtime. -->
  <ItemGroup>
    <Reference Include="VRage" HintPath="$(SEBin)\VRage.dll" Private="false" />
    <Reference Include="VRage.Library" HintPath="$(SEBin)\VRage.Library.dll" Private="false" />
    <Reference Include="VRage.Game" HintPath="$(SEBin)\VRage.Game.dll" Private="false" />
    <Reference Include="VRage.Math" HintPath="$(SEBin)\VRage.Math.dll" Private="false" />
    <Reference Include="Sandbox.Common" HintPath="$(SEBin)\Sandbox.Common.dll" Private="false" />
    <Reference Include="Sandbox.Game" HintPath="$(SEBin)\Sandbox.Game.dll" Private="false" />
    <!-- ModAPI interfaces for landing gear and other SpaceEngineers.Game blocks. -->
    <Reference Include="SpaceEngineers.Game" HintPath="$(SEBin)\SpaceEngineers.Game.dll" Private="false" />
    <Reference Include="SpaceEngineers.ObjectBuilders" HintPath="$(SEBin)\SpaceEngineers.ObjectBuilders.dll" Private="false" />
  </ItemGroup>
  <!-- .NET Framework has no inbox System.Text.Json; use the copy the game ships. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Text.Json" HintPath="$(SEBin)\System.Text.Json.dll" Private="false" />
    <Reference Include="System.Memory" HintPath="$(SEBin)\System.Memory.dll" Private="false" />
    <Reference Include="System.Threading.Tasks.Extensions" HintPath="$(SEBin)\System.Threading.Tasks.Extensions.dll" Private="false" />
    <Reference Include="Microsoft.Bcl.AsyncInterfaces" HintPath="$(SEBin)\Microsoft.Bcl.AsyncInterfaces.dll" Private="false" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <Target Name="SEMcpCheckGamePath" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(SEBin)\SpaceEngineers.exe')">
    <Error Text="Space Engineers not found in '$(SEBin)'. Set SEBin to your game's Bin64 folder: copy Directory.Build.local.props.example to Directory.Build.local.props and edit it (see README)." />
  </Target>
</Project>
