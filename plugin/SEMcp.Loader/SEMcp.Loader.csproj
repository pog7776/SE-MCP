<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SEMcp.Loader</AssemblyName>
    <RootNamespace>SEMcp.Loader</RootNamespace>
    <!-- The loader can't be hot-reloaded; keep it small and change it rarely. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- Pulsar loads precompiled plugins from <PulsarDir>\<flavour>\Local. Skipped (with a warning) if SE has the DLL locked. -->
  <PropertyGroup>
    <PulsarFlavour Condition="'$(TargetFramework)' == 'net48'">Legacy</PulsarFlavour>
    <PulsarFlavour Condition="'$(TargetFramework)' != 'net48'">Interim</PulsarFlavour>
  </PropertyGroup>
  <Target Name="DeployToPulsar" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' And '$(TargetFramework)' != ''">
    <MakeDir Directories="$(PulsarDir)\$(PulsarFlavour)\Local" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PulsarDir)\$(PulsarFlavour)\Local" ContinueOnError="WarnAndContinue" />
  </Target>
</Project>
