<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SEMcp.Loader</AssemblyName>
    <RootNamespace>SEMcp.Loader</RootNamespace>
    <Version>0.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VRage" HintPath="$(SEBin)\VRage.dll" Private="false" />
    <Reference Include="VRage.Library" HintPath="$(SEBin)\VRage.Library.dll" Private="false" />
    <Reference Include="Sandbox.Game" HintPath="$(SEBin)\Sandbox.Game.dll" Private="false" />
  </ItemGroup>

  <!-- Pulsar loads precompiled plugins from <PulsarDir>\Legacy\Local. Skipped if SE has the DLL locked. -->
  <PropertyGroup>
    <PulsarLocal Condition="'$(PulsarLocal)' == ''">$(APPDATA)\Pulsar\Legacy\Local</PulsarLocal>
  </PropertyGroup>
  <Target Name="DeployToPulsar" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <MakeDir Directories="$(PulsarLocal)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PulsarLocal)" ContinueOnError="WarnAndContinue" />
  </Target>
</Project>
